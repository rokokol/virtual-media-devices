#!/usr/bin/env bash
# Reports whatever mime type the case asked for, so the suite can drive the image/video/
# unsupported branches without carrying media files. The call is logged too: the real file(1)
# answers inode/symlink unless it is told to follow one, so which flags it was given is the
# difference between playing a symlinked video and refusing it
set -euo pipefail

[[ -n "${FILE_ARGV:-}" ]] && printf '%s\n' "$@" >"$FILE_ARGV"

printf '%s\n' "${FILE_MIME:-video/mp4}"
